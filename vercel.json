{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "status.elexvx.com" }],
      "destination": "/status"
    },
    {
      "source": "/history",
      "has": [{ "type": "host", "value": "status.elexvx.com" }],
      "destination": "/status"
    },
    { "source": "/status/history", "destination": "/status" }
  ]
}
